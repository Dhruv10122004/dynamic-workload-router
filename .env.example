# Copy to .env and edit. .env is never committed.
# One file can hold both sections: on the Windows laptop the controller and the
# Edge agent share the checkout. Each process reads only its own keys.

# ---------------- Controller (Windows laptop) ----------------
# Comma-separated addresses to listen on: 127.0.0.1 plus the LAN or Tailscale IP.
DWR_BIND_HOSTS=127.0.0.1
DWR_PORT=8000
DWR_CONTROLLER_DATA_DIR=./var/controller
# worker_id:token pairs, comma-separated. Each worker's DWR_WORKER_TOKEN must match.
DWR_WORKER_TOKENS=edge-1:change-me-edge,fog-1:change-me-fog
# Admin/UI calls from anywhere other than 127.0.0.1 need X-Admin-Token.
DWR_ADMIN_TOKEN=change-me-admin
# 1 enables test-only parameters (mem_touch.actual_mb_override). Never in experiments.
DWR_TEST_MODE=0
DWR_STALE_S=5
# Cores for the controller process. Default: every core not used by DWR_SLOT_CPUS.
# DWR_CONTROLLER_CPUS=0,1
# Slots for start.ps1 -Sim's simulated Fog worker. Default: the two highest free cores.
# DWR_SIM_SLOT_CPUS=6;7
# Scheduler defaults (PUT /api/v1/scheduler changes them while idle; the active values persist).
# LocalFirst | EdgeOnly | FogOnly | RoundRobin
DWR_POLICY=LocalFirst
DWR_HOST_BUSY_ENABLED=1
DWR_HOST_BUSY_HIGH=70
DWR_HOST_BUSY_LOW=50
DWR_AGING_S=30

# ---------------- Worker agent (each machine) ----------------
DWR_WORKER_ID=edge-1
# edge | fog   (cloud reserved for V2)
DWR_TIER=edge
DWR_CONTROLLER_URL=http://127.0.0.1:8000
DWR_WORKER_TOKEN=change-me-edge
# One entry per slot; ";" separates slots, "," separates cores within a slot.
DWR_SLOT_CPUS=1
DWR_MEM_BUDGET_MB=1536
# Minimum host free memory that must remain after admission.
DWR_MEM_FLOOR_MB=512
DWR_DATA_DIR=./var/worker
